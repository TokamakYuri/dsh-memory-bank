# Normalize line endings in the repository, but leave the working tree alone.
#
# This package is authored on Windows and installed on any platform, and its
# source ships as-is (no build step), so what the reader sees should not depend
# on who cloned it.
* text=auto eol=lf

# Windows-only helper scripts keep CRLF so they run from a plain cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets, if any are ever added.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
